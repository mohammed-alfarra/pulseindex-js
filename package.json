{
  "name": "@pulseindex/sdk",
  "version": "1.1.0",
  "description": "Official Node.js & TypeScript SDK for the PulseIndex ultra-fast search engine",
  "license": "MIT",
  "author": "PulseIndex",
  "keywords": [
    "pulseindex",
    "sdk",
    "grpc",
    "search",
    "indexing",
    "geohash",
    "bitwise",
    "typescript",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammed-alfarra/pulseindex-js.git"
  },
  "homepage": "https://github.com/mohammed-alfarra/pulseindex-js#readme",
  "bugs": {
    "url": "https://github.com/mohammed-alfarra/pulseindex-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./proto/engine.proto": "./proto/engine.proto"
  },
  "files": [
    "dist",
    "proto",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check:proto": "node scripts/check-proto.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
